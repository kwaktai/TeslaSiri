#usda 1.0
(
    defaultPrim = "Vehicle"
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "Vehicle" (
    prepend references = @./Vehicle.usdz@</Vehicle>
)
{
    over "Body"
    {
        over "Wheel_LF_Spatial"
        {
            over "Wheels_Marker"
            {
                over "Suspension_Dynamic_Collision_Area"
                {
                    token visibility = "inherited"
                }
            }
        }

        over "Hood_Spatial"
        {
            over "Frunk_Marker"
            {
                over "Frunk_Marker_Dynamic_Collision_Area"
                {
                    token visibility = "inherited"
                }
            }

            over "Headlights_Beam2"
            {
                token visibility = "inherited"

                over "LeftGlow"
                {
                    token visibility = "inherited"
                }

                over "RightGlow"
                {
                    token visibility = "inherited"
                }
            }

            over "DRL2"
            {
                token visibility = "inherited"
            }
        }

        over "Door_LF_Spatial"
        {
            over "Window_LF_Spatial"
            {
                over "Window_LF2"
                {
                    over "Window_LF_Dynamic_Collision_Area"
                    {
                        token visibility = "inherited"
                    }
                }
            }
        }

        over "Door_LR_Spatial"
