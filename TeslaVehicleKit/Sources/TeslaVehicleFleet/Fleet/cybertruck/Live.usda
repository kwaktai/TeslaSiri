        {
            token visibility = "inherited"
        }

        over "Headlights_Projections2"
        {
            token visibility = "inherited"
        }

        over "Bed_Light2"
        {
            token visibility = "inherited"
        }

        over "Right_Turn_Signal_Front2"
        {
            token visibility = "inherited"
        }

        over "Left_Turn_Signal_Front2"
        {
            token visibility = "inherited"
        }

        over "Reverse_Lights2"
        {
            token visibility = "inherited"
