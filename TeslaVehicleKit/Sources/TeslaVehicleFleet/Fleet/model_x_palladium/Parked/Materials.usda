def Material "Paint"
{
    asset inputs:DiffuseWeight = @PaintDiffuseWeight.png@
    asset inputs:SpecWeight = @PaintSpecWeight.png@
    token outputs:mtlx:surface.connect = </Paint/n100.outputs:out>

    def Shader "n1"
    {
        uniform token info:id = "ND_normal_vector3"
        string inputs:space = "world"
        vector3f outputs:out
    }

    def Shader "n2"
    {
        uniform token info:id = "ND_realitykit_viewdirection_vector3"
        string inputs:space = "world"
        vector3f outputs:out
