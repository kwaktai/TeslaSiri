{
  "sourceLanguage": "en",
  "strings": {
    "0 turns it off, 1 is low, 2 is medium, and 3 is high. \"Turn on my seat heater\" means 3.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "0은 끔, 1은 약, 2는 중, 3은 강입니다. “열선 켜 줘”는 3입니다."
          }
        }
      }
    },
    "1 visit": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "1회"
          }
        }
      }
    },
    "3D Replay": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "3D 재생"
          }
        }
      }
    },
    "A Tesla software version such as 2026.38.1. Leave empty for the pending update, or the installed version when there's no update.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "소프트웨어 버전입니다. 예: 2026.38.1. 비우면 대기 중인 업데이트, 없으면 설치된 버전입니다."
          }
        }
      }
    },
    "A Tessie drive tag to match, such as \"Work\" or \"Commute\". Leave empty for all drives.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "주행 태그입니다. 예: Work. 비우면 모든 주행입니다."
          }
        }
      }
    },
    "A short category or tagline for the feature.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기능의 짧은 분류입니다."
          }
        }
      }
    },
    "A word to keep only matching features, such as FSD, Autopilot, Dashcam, or Navigation. Leave empty to read all the notes.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 단어가 들어간 기능만 읽습니다. 예: FSD. 비우면 모든 노트입니다."
          }
        }
      }
    },
    "API key": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "API 키"
          }
        }
      }
