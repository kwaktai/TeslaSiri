    "Turn steering wheel heater \\(\\.$on) in \\(\\.$vehicle)": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\\(\\.$vehicle) 핸들 열선 \\(\\.$on)"
          }
        }
      }
    },
    "Turns Bioweapon Defense Mode positive-pressure HEPA cabin filtration on or off on supported Tesla vehicles. Omit the vehicle parameter to target the user's selected car.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지원되는 차에서 생화학 방어 모드(HEPA 양압)를 켜거나 끕니다. 차량을 비우면 선택된 차를 사용합니다."
          }
        }
      }
    },
    "Turns Dog Mode (pet climate keeper) on or off in a Tesla vehicle. Turning Dog Mode off requires user confirmation so a pet inside is not inadvertently left without climate control.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "펫 모드를 켜거나 끕니다. 끌 때는 확인을 받아 실내에 있는 펫이 공조 없이 남지 않게 합니다."
          }
        }
      }
    },
    "Turns Sentry Mode exterior camera security monitoring on or off on a Tesla vehicle. Turning Sentry Mode off prompts the user for confirmation.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "감시 모드를 켜거나 끕니다. 끌 때는 확인을 받습니다."
          }
        }
      }
    },
    "Turns maximum windshield and cabin defrost on or off in the user's car (or Tesla). Omit the vehicle parameter to target the user's selected car.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "유리와 실내 최대 성에 제거를 켜거나 끕니다. 차량을 비우면 선택된 차를 사용합니다."
          }
        }
      }
    },
    "Turns off cabin heating and air conditioning in the user's car (or Tesla), such as after preconditioning. Doesn't affect charging. Use the Stop Tesla Charging tool to end a charging session.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실내 냉난방을 끕니다. 충전은 멈추지 않습니다. 충전을 끝내려면 충전 중지 도구를 사용합니다."
          }
        }
      }
    },
    "Turns the heated steering wheel on or off. Turning it on also turns on the car's climate. Not every Tesla has a heated steering wheel.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "핸들 열선을 켜거나 끕니다. 켜면 공조도 켜집니다. 없는 차도 있습니다."
          }
        }
      }
    },
