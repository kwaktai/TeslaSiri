        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "차량 상태"
          }
        }
      }
    },
    "Vehicle overview": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "차량 개요"
          }
        }
      }
    },
    "Vehicles": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "차량"
          }
        }
      }
    },
    "Vent Tesla Windows": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Tesla 창문 환기"
          }
        }
      }
    },
    "Vent Windows": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "창문 환기"
          }
        }
      }
    },
    "Vent \\(\\.$vehicle) windows": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\\(\\.$vehicle) 창문 환기"
          }
        }
      }
    },
    "Vent \\(\\.$vehicle) windows with \\(.applicationName)": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\\(.applicationName)으로 \\(\\.$vehicle) 창문 환기"
          }
        }
      }
    },
    "Vent my car windows": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내 차 창문 환기"
          }
        }
      }
    },
    "Vent my car windows with \\(.applicationName)": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\\(.applicationName)으로 내 차 창문 환기"
          }
        }
      }
    },
    "Vent windows": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "창문 환기"
          }
        }
      }
    },
    "Ventilated (cooled) front seats; only on cars that have them": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "통풍 앞좌석. 있는 차만"
          }
        }
      }
    },
    "Waiting for the car": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "차를 기다리는 중"
          }
        }
      }
    },
    "Warm up \\(\\.$vehicle) with \\(.applicationName)": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\\(.applicationName)으로 \\(\\.$vehicle) 예열"
          }
        }
      }
    },
    "Warm up my car": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내 차 예열"
          }
        }
      }
    },
    "Warm up my car with \\(.applicationName)": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\\(.applicationName)으로 내 차 예열"
          }
        }
      }
    },
    "Warm up or start climate in \\(\\.$vehicle)": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\\(\\.$vehicle) 예열 또는 공조 켜기"
          }
        }
      }
    },
    "Warming cabin": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실내를 데우는 중"
          }
        }
      }
    },
    "Warms (or cools, on cars with ventilated seats) one of the car's physical seats, from 0 (off) to 3 (high). Turns the car's climate on, since seat heat only runs while climate is on. To set the cabin temperature or several climate settings at once, use the Configure Tesla Cabin Climate tool instead.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "좌석 열선이나 통풍을 0(끔)에서 3(강)으로 설정합니다. 공조가 켜져야 동작하므로 공조를 켭니다."
          }
        }
      }
    },
    "Warms up or cools down the user's car (or Tesla) in one step: cabin temperature, max defrost, seat heat, the steering wheel heater, Dog Mode, and Bioweapon Defense Mode. Turns climate on. Use when the user asks for more than one climate change, or to warm up, cool down, or precondition their car before leaving.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실내 온도, 성에 제거, 시트 열선, 핸들 열선, 펫 모드, 생화학 방어를 한 번에 설정하고 공조를 켭니다. 출발 전 준비에 사용합니다."
          }
        }
      }
    },
    "Warms up, cools down, or preconditions the user's car or Tesla by starting cabin HVAC at its current setpoint. Use for requests like \"warm up my car\", \"cool down my car\", or \"warm up my Tesla\". Use Set Car Temperature for a target temperature, or Configure Tesla Cabin Climate for multi-setting prep.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 설정 온도로 실내 공조를 켜 차를 예열하거나 냉방합니다. 목표 온도는 실내 온도 설정, 여러 설정을 한꺼번에 바꾸려면 실내 공조 설정을 사용합니다."
          }
        }
      }
    },
    "What temperature?": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "온도는 몇 도로 할까요?"
          }
        }
      }
    },
    "What would you like to know about your car?": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "차의 무엇을 알려 드릴까요?"
          }
        }
      }
    },
    "When the car last reported this data. Older readings can be stale if the car is asleep.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "차가 이 값을 마지막으로 보낸 시각입니다. 절전 중이면 오래되었을 수 있습니다."
          }
        }
      }
    },
    "When the command ran.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "명령을 실행한 시각입니다."
          }
        }
      }
    },
    "When to start installing, such as tonight at 2 AM, in the user's time zone. Leave empty to start right away.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설치를 시작할 시각입니다. 비우면 바로 시작합니다."
          }
        }
      }
    },
    "Where did I drive in \\(.applicationName)": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\\(.applicationName)에서 최근 주행 보기"
          }
        }
      }
    },
    "Where the car is, and its speed if it's driving": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "차 위치와, 주행 중이면 속도"
          }
        }
      }
    },
    "Where to go, as specific as possible: a full street address, a place name with its city such as \"Blue Bottle Coffee, Oakland\", a map link, or \"37.7749,-122.4194\".": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "갈 곳입니다. 주소, 도시가 포함된 장소, 지도 링크, 또는 위도,경도."
          }
        }
      }
    },
    "Where to?": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어디로 갈까요?"
          }
        }
      }
    },
    "Whether Dog Mode is keeping the cabin conditioned for a pet.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "펫을 위해 실내 온도를 유지하는 중인지입니다."
          }
        }
      }
    },
    "Whether Sentry Mode (camera security monitoring while parked) is on.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "주차 중 카메라 감시 모드가 켜져 있는지입니다."
          }
        }
      }
    },
    "Whether Tessie accepted the command and sent it to the car.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버가 명령을 받아 차로 보냈는지입니다."
          }
        }
      }
    },
    "Whether a newer software version is downloading, ready, scheduled, or installing.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 버전이 다운로드 중인지, 설치 가능한지, 예약됐는지, 설치 중인지입니다."
          }
        }
      }
    },
    "Whether max defrost (windshield and cabin defrost at full power) is on.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "유리와 실내 성에 제거가 최대인지입니다."
          }
        }
      }
    },
    "Whether the cabin heating and air conditioning is running.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실내 냉난방이 켜져 있는지입니다."
          }
        }
      }
    },
    "Whether the charge port door is open.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "충전구가 열려 있는지입니다."
          }
        }
      }
    },
    "Whether the doors are locked.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "문이 잠겼는지입니다."
          }
        }
      }
    },
    "Whether the heated steering wheel is on.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "핸들 열선이 켜져 있는지입니다."
          }
        }
      }
    },
    "Whether the update has finished downloading and can be installed right now.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다운로드가 끝나 지금 설치할 수 있는지입니다."
          }
        }
      }
    },
    "Which charging session?": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어느 충전인가요?"
          }
        }
      }
    },
    "Which command ran, such as door_lock, set_temps, or navigation_request.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실행된 명령입니다. 예: door_lock."
          }
        }
      }
    },
    "Which drive would you like details for?": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어느 주행을 볼까요?"
          }
        }
      }
    },
    "Which seat to change. \"My seat\" means the driver seat.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "바꿀 좌석입니다. “내 자리”는 운전석입니다."
          }
        }
      }
    },
    "Which vehicle?": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어느 차인가요?"
          }
        }
      }
    },
    "Widget Category": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위젯 종류"
          }
        }
      }
    },
    "Your vehicles": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내 차량"
          }
        }
      }
    },
    "\\(\\.$action) charge port on \\(\\.$vehicle)": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\\(\\.$vehicle) 충전구 \\(\\.$action)"
          }
        }
      }
    },
    "\\(\\.$action) charge port on my car": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내 차 충전구 \\(\\.$action)"
          }
        }
      }
    },
    "km/h": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "km/h"
          }
        }
      }
    },
    "mph": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "mph"
          }
        }
      }
    },
    "true for Supercharger sessions only, false for AC sessions only (home or destination chargers). Leave empty for both.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "true면 슈퍼차저만, false면 집이나 목적지 충전만. 비우면 둘 다입니다."
          }
        }
      }
    },
    "true to turn on Bioweapon Defense Mode (HEPA filtration with positive cabin pressure) for smoke, pollen, or bad air; false to turn it off. Leave empty to leave it unchanged. Only on cars with a HEPA filter.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연기나 꽃가루에 생화학 방어 모드를 켜거나 끕니다. HEPA 필터가 있는 차만 됩니다."
          }
        }
      }
    },
    "true to turn on Dog Mode, which keeps the cabin comfortable for a pet and shows a message on the screen; false to turn it off (the user is asked to confirm). Leave empty to leave it unchanged.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "펫 모드입니다. 끄면 확인을 받습니다. 비우면 그대로 둡니다."
          }
        }
      }
    },
    "true to turn on max defrost for an icy or fogged windshield, false to turn it off. Leave empty to leave defrost unchanged.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "유리 성에가 있으면 true, 끄려면 false. 비우면 그대로 둡니다."
          }
        }
      }
    },
    "true to turn on the heated steering wheel, false to turn it off. Leave empty to leave it unchanged. Not every Tesla has one.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "핸들 열선을 켜거나 끕니다. 비우면 그대로 둡니다. 없는 차도 있습니다."
          }
        }
      }
    },
    "true to turn the heater on, false to turn it off.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "true면 켜고, false면 끕니다."
          }
        }
      }
    },
    "up to date": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최신"
          }
        }
      }
    },
    "°F or °C, matching the car's display setting.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "차 화면과 같은 °F 또는 °C입니다."
          }
        }
      }
    },
    "Warming": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "예열 중"
          }
        }
      }
    },
    "Honk": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "경적"
          }
        }
      }
    },
    "Cooler": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "낮추기"
          }
        }
      }
    },
    "Warmer": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "높이기"
          }
        }
      }
    },
    "Turn On": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "켜기"
          }
        }
      }
    },
    "Installing Update": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "업데이트 설치 중"
          }
        }
      }
    },
    "Autopilot Share": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오토파일럿 비율"
          }
        }
      }
    },
    "Drive Time": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "주행 시간"
          }
        }
      }
    },
    "Latest": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최근"
          }
        }
      }
    },
    "Capacity": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "용량"
          }
        }
      }
    },
    "100% Range": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "100% 주행거리"
          }
        }
      }
    },
    "Lifetime": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "누적"
          }
        }
      }
    },
    "Avg": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "평균"
          }
        }
      }
    },
    "Front left": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앞 왼쪽"
          }
        }
      }
    },
    "Rear left": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "뒤 왼쪽"
          }
        }
      }
    },
    "Front right": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앞 오른쪽"
          }
        }
      }
    },
    "Rear right": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "뒤 오른쪽"
          }
        }
      }
    },
    "Pause": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일시정지"
          }
        }
      }
    },
    "Play": {
      "localizations": {
