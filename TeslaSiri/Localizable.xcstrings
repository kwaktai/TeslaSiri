        "ko" : { "stringUnit" : { "state" : "translated", "value" : "서버 주소" } }
      }
    },
    "Stored in Keychain" : {
      "localizations" : {
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "Keychain에 저장됨" } }
      }
    },
    "Tesla server" : {
      "localizations" : {
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "Tesla 서버" } }
      }
    },
    "This Tesla server does not keep past charging sessions. An active charge still appears here." : {
      "localizations" : {
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "이 Tesla 서버는 지난 충전 기록을 보관하지 않습니다. 진행 중인 충전은 여기에 표시됩니다." } }
      }
    },
    "This Tesla server does not provide drive history. Demo Car mode still has sample drives." : {
      "localizations" : {
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "이 Tesla 서버는 주행 기록을 제공하지 않습니다. 데모 차량 모드에는 예시 주행이 있습니다." } }
      }
    }
