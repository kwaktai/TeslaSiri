          }
        }
      }
    },
    "Locks all doors on the user's car (or Tesla) immediately. Use when the user says \"lock my car\" or \"lock my Tesla\". Omit the vehicle parameter to lock the user's selected car.": {
      "localizations": {
        "ko": {
