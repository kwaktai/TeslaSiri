    "Installed": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설치됨"
          }
        }
      }
    },
    "Installing": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설치 중"
          }
        }
      }
    },
    "Installs the software update that has finished downloading to the user's Tesla, now or at a time the user picks, after asking the user to confirm. The car can't be driven while it installs, usually 20 to 40 minutes. If the update is still downloading or already installing, this tool says so instead of installing.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "확인 후 다운로드가 끝난 소프트웨어 업데이트를 지금 또는 지정한 시각에 설치합니다. 설치 중에는 운전할 수 없습니다. 아직 받는 중이거나 이미 설치 중이면 그 상태를 말합니다."
          }
        }
      }
    },
    "Interactive Apple Maps route, start & end timeline, Autopilot segments, Satellite toggle & multi-drive stepper": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 지도 경로, 출발·도착, 오토파일럿 구간, 위성 지도, 주행 넘기기"
          }
        }
      }
    },
    "Interactive cabin temperature +/- controls & active comfort badges": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실내 온도 조절과 편의 기능 배지"
          }
        }
      }
    },
    "Issuer": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "발급자"
          }
        }
      }
    },
