    "Set true to enable Dog Mode, or false to disable Dog Mode (prompts for confirmation).": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "true면 펫 모드를 켭니다. false면 확인 후 끕니다."
          }
        }
      }
    },
    "Set true to enable Sentry Mode security monitoring, or false to disable Sentry Mode (prompts for confirmation).": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "켜면 감시 모드를 켭니다. 끄면 확인 후 감시 모드를 끕니다."
          }
        }
      }
    },
    "Set true to turn Bioweapon Defense Mode on, or false to turn it off.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "true면 생화학 방어 모드를 켜고, false면 끕니다."
          }
        }
      }
    },
    "Set true to turn max defrost on, or false to turn max defrost off.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "true면 최대 성에 제거를 켜고, false면 끕니다."
          }
        }
      }
    },
    "Sets the maximum battery state-of-charge percentage (50% to 100%) at which charging stops on a Tesla vehicle, after user confirmation. Use 80% for typical daily driving or up to 100% before long road trips.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "확인 후 충전이 멈추는 배터리 한도를 50%에서 100% 사이로 설정합니다. 매일은 80%, 장거리는 100%까지."
          }
        }
      }
    },
    "Sets the maximum current the car draws while AC charging, in amps, to charge more slowly or share a circuit. It doesn't change the charge limit; use the Set Tesla Charge Limit tool for that. Doesn't affect Supercharging.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "교류 충전 전류(A)를 바꿉니다. 충전 한도는 바꾸지 않고, 슈퍼차저에는 영향이 없습니다."
          }
        }
      }
    },
    "Shares a destination to the user's Tesla so its built-in touchscreen navigation has the route ready when they get in the car. Accepts a street address, a place or business name with its city, a map link, or latitude and longitude. Doesn't open Maps or start navigation on this device.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "목적지를 차로 보내 탑승 시 내비게이션에 경로가 있게 합니다. 주소, 장소, 지도 링크, 좌표를 받습니다. 이 기기에서 지도를 열거나 안내를 시작하지는 않습니다."
          }
        }
      }
    },
