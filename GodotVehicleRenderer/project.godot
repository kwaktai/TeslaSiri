; Engine configuration file.
; Edit through the Godot editor when possible.

config_version=5

[application]

config/name="TeslaSiri Vehicle Renderer"
run/main_scene="res://main.tscn"

[display]

window/size/viewport_width=1672
window/size/viewport_height=941
window/size/window_width_override=1672
window/size/window_height_override=941
window/stretch/mode="canvas_items"

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
renderer/rendering_method.web="gl_compatibility"
renderer/rendering_method.ios="mobile"
environment/defaults/default_clear_color=Color(0.018, 0.015, 0.016, 1)

[physics]

common/enable_pause_aware_picking=false
